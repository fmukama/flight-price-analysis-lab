# 1. AIRFLOW CORE CONFIGURATION
# Unique Airflow User ID to match host permissions (prevents permission denied on mounted volumes)
# On Linux/macOS run `id -u` (usually 50000 or 1000). On Windows, 50000 is standard.
AIRFLOW_UID=50000

# Secret key used for signing session cookies in the Airflow Web UI
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# 2. MYSQL (STAGING DATABASE) CONFIGURATION
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=staging_db
MYSQL_USER=staging_user
MYSQL_PASSWORD=staging_password
MYSQL_ROOT_PASSWORD=root_password

# 3. POSTGRESQL (ANALYTICS & AIRFLOW METADATA DATABASE) CONFIGURATION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=analytics_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# Separate database name on the same Postgres instance used for Airflow metadata
AIRFLOW_METADATA_DB=airflow_db

# 4. JUPYTERLAB CONFIGURATION
JUPYTER_PORT=8888
JUPYTER_TOKEN=easyeda2026