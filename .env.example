# 1. AIRFLOW CORE CONFIGURATION
# Unique Airflow User ID to match host permissions (prevents permission denied on mounted volumes)
# On Linux/macOS run `id -u` (usually 50000 or 1000). On Windows, 50000 is standard.
AIRFLOW_UID=50000

# Initial Airflow Web UI admin credentials, created once by the airflow-init service
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Secret key used for signing Airflow Web UI session cookies. Any non-empty
# value works locally; keep it stable so sessions survive a restart.
AIRFLOW_WEBSERVER_SECRET_KEY=flight_price_local_dev_secret

# Host port for the Airflow Web UI (container always listens on 8080)
AIRFLOW_WEB_PORT=8080

# 2. MYSQL (STAGING DATABASE) CONFIGURATION
# NOTE ON PORTS: *_HOST_PORT is published to your machine and may be changed
# freely to avoid a clash with a locally installed server. *_PORT is the port
# the pipeline scripts dial *inside* the compose network and must stay at the
# database's real listening port. Conflating the two makes the ETL connect to
# a port nothing is listening on.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=staging_db
MYSQL_USER=staging_user
MYSQL_PASSWORD=staging_password
MYSQL_ROOT_PASSWORD=root_password

# 3. POSTGRESQL (ANALYTICS & AIRFLOW METADATA DATABASE) CONFIGURATION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=analytics_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# Separate database name on the same Postgres instance used for Airflow metadata
AIRFLOW_METADATA_DB=airflow_db

# 4. JUPYTERLAB CONFIGURATION
JUPYTER_PORT=8888
JUPYTER_TOKEN=easyeda2026
